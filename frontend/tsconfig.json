{
	"extends": "@vue/tsconfig/tsconfig.dom.json",
	"compilerOptions": {
		// "node" is here for two reasons: vite.config.ts runs in Node, and importing
		// the backend's AppRouter pulls its source into this program, where `process`
		// is referenced. Both are build-time only - no backend code reaches the bundle.
		"types": ["vite/client", "node"],

		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,

		"noEmit": true
	},
	// Vue SFCs are type-checked by the content mapper, which tsc loads as a plugin.
	// Alpha: see the "Type checking .vue files" section of README.md.
	"contentMappers": [
		{
			"package": "@vue/content-mapper",
			"extensions": [".vue"],
			"options": { "target": 3.5 }
		}
	],
	"include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "vitest.config.ts"]
}
