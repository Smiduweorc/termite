{
	"name": "@termite/backend",
	"version": "1.1.1",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./trpc": "./src/trpc/routers/index.ts"
	},
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"start": "bun run src/index.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:deploy": "bun run src/db/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "bun run src/db/seed.ts",
		"admin:create": "bun run src/scripts/create-admin.ts"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/openapi": "^1.4.16",
		"@grml/nomadic": "^0.1.1",
		"@grpc/grpc-js": "^1.14.5",
		"@grpc/proto-loader": "^0.8.1",
		"@node-rs/argon2": "^2.2.1",
		"@trpc/server": "^11.19.0",
		"arktype": "^2.2.7",
		"cookie": "^2.0.1",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.3",
		"elysia": "^1.4.30",
		"lacewing": "^1.2.0",
		"nodemailer": "^9.1.1",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"pino-pretty": "^13.1.3"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@types/bun": "^1.4.2",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "^4.1.11",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.23.15",
		"vitest": "^4.1.11"
	}
}
