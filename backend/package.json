{
	"name": "@termite/backend",
	"version": "1.1.2",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./trpc": "./src/trpc/routers/index.ts"
	},
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"start": "bun run src/index.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:deploy": "bun run src/db/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "bun run src/db/seed.ts",
		"admin:create": "bun run src/scripts/create-admin.ts"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/openapi": "^1.4.16",
		"@grml/nomadic": "^0.1.1",
		"@grpc/grpc-js": "^1.14.6",
		"@grpc/proto-loader": "^0.8.1",
		"@node-rs/argon2": "^2.2.2",
		"@trpc/server": "^11.19.0",
		"arktype": "^2.2.8",
		"cookie": "^2.0.1",
		"dotenv": "^18.0.8",
		"drizzle-orm": "^0.45.4",
		"elysia": "^1.4.30",
		"lacewing": "^2.0.0",
		"nodemailer": "^10.1.1",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.10",
		"@types/bun": "^1.4.3",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "^5.0.4",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.23.15",
		"vitest": "^5.0.4"
	}
}
