{
	"name": "@bevd/backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./trpc": "./src/trpc/routers/index.ts"
	},
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"start": "bun run src/index.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "bun run src/db/seed.ts"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/openapi": "^1.4.15",
		"@grpc/grpc-js": "^1.14.4",
		"@grpc/proto-loader": "^0.8.1",
		"@node-rs/argon2": "^2.0.2",
		"@trpc/server": "^11.18.0",
		"arktype": "^2.2.3",
		"cookie": "^2.0.1",
		"drizzle-orm": "^0.45.2",
		"elysia": "^1.4.29",
		"lacewing": "^1.0.1",
		"pg": "^8.22.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.4",
		"@types/bun": "^1.3.14",
		"@types/pg": "^8.20.0",
		"@vitest/coverage-v8": "^4.1.10",
		"drizzle-kit": "^0.31.10",
		"vitest": "^4.1.10"
	}
}
