# Bun loads this file automatically when it is named `.env`:
#   cp .env.example .env

NODE_ENV=development
# Elysia serves REST + tRPC here.
PORT=3000
# The gRPC server listens separately - gRPC needs HTTP/2, Elysia speaks HTTP/1.1.
GRPC_PORT=50051

# debug | info | warn | error | silent
# Pretty-printed while NODE_ENV=development, NDJSON otherwise (what a log shipper wants).
LOG_LEVEL=info
# Tags every log line, so one stream can carry more than one service.
SERVICE_NAME=termite-backend

# Matches the credentials in ../docker-compose.yml
DATABASE_URL=postgres://termite:termite@localhost:5432/termite

# Where the Vue dev server runs. Cookies will not work without this - the browser
# refuses to send credentials to an origin the server has not allowed.
CORS_ORIGIN=http://localhost:5173

# --- Auth ---------------------------------------------------------------------------
# Signs access tokens. At least 32 characters, and lacewing entropy-checks it at
# boot: cryptographically random or it refuses to import - a human-chosen
# passphrase will not start the app. Generate one:
#   openssl rand -base64 48
JWT_SECRET=

# How long an access token lives. Keep it short: it cannot be revoked before it
# expires. lacewing caps access tokens at 1h - longer refuses to sign.
JWT_ACCESS_EXPIRY=15m

# Pinned into (and checked against) every token. A token minted for another
# deployment fails verification here regardless of its signature.
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=http://localhost:3000/trpc

# Refresh tokens are opaque, stored hashed and revocable, so this can be generous.
REFRESH_TOKEN_TTL_DAYS=7

# lax | strict. There is no "none" and no COOKIE_SECURE switch: every cookie is
# Secure, unconditionally (http://localhost counts as a secure context, so dev
# works; anything non-local must be https).
COOKIE_SAME_SITE=lax

# Empty in development, and it has to be: the Vite server and the API are both on
# localhost, so the CSRF cookie is already readable by the page. It only earns its keep
# in a deployment where the board and the API are on different hostnames - see
# .env.release.example at the repo root for what setting it costs.
COOKIE_DOMAIN=

# --- Mail ---------------------------------------------------------------------------
# Where the board is served to people. Invite and password-reset links point here,
# so it is the frontend's origin, not the API's.
APP_URL=http://localhost:5173

# SMTP is optional. Leave SMTP_HOST empty and the app still works: invite and reset
# links are written to the log instead of emailed, which is a reasonable way to run a
# small self-hosted board. Set it for anything where the log is not just yours.
SMTP_HOST=
# 587 with STARTTLS (the usual), or 465 with SMTP_SECURE=true for implicit TLS.
SMTP_PORT=587
SMTP_SECURE=false
# Leave both empty for a relay that does not authenticate (a local postfix, say).
SMTP_USER=
SMTP_PASSWORD=
# What the recipient sees. Plain address, or "Name <address>".
MAIL_FROM=Termite <termite@localhost>
