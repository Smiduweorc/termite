# The build context is the repo root for both images, and each runtime stage copies a
# workspace wholesale. Anything not listed here ends up baked into an image.
#
# Patterns are matched against the whole path relative to this file, so a bare
# `node_modules/` would only ever match the one at the root - `backend/node_modules` and
# `frontend/node_modules` would sail straight through. Hence `**/` on everything that can
# exist at more than one level.

# Installed inside the image, for the image's platform. A host node_modules - carrying
# native binaries built for the wrong libc - must never be copied over that. This matters
# most for the backend: bun resolves upward from backend/src, so a stray
# /app/backend/node_modules would shadow the correctly-built /app/node_modules entirely
# and @node-rs/argon2 would load a glibc .node inside an Alpine container.
**/node_modules

# Stale local build output. The backend container runs from src/, and the frontend image
# builds dist/ itself in its build stage.
**/dist
**/*.tsbuildinfo

# Secrets. .env.example is documentation and stays.
**/.env
**/.env.*
!**/.env.example

.git/
.github/
.vscode/
**/coverage
**/*.log

# Tests and tooling config: none of it runs in production.
**/*.test.ts
README.md
biome.jsonc
commitlint.config.js
lefthook.yml
docker-compose.yml
docker-compose.release.yml
