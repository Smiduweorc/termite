{
	"name": "termite",
	"version": "1.1.1",
	"private": true,
	"type": "module",
	"description": "A self-hostable feedback board and release tracker for projects that ship in versions.",
	"workspaces": [
		"backend",
		"frontend"
	],
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"build": "bun run --filter '*' build",
		"test": "bun run --filter '*' test",
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:push": "bun run --cwd backend db:push",
		"db:generate": "bun run --cwd backend db:generate",
		"db:migrate": "bun run --cwd backend db:migrate",
		"db:studio": "bun run --cwd backend db:studio",
		"db:seed": "bun run --cwd backend db:seed",
		"admin:create": "bun run --cwd backend admin:create",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"lefthook": "^2.1.14",
		"typescript": "^7.0.2"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
