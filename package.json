{
	"name": "bevd-base-lacewing",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Bun + Elysia + Vue + Drizzle, with tRPC, gRPC, and JWT auth + CSRF built on lacewing.",
	"workspaces": [
		"backend",
		"frontend"
	],
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"build": "bun run --filter '*' build",
		"test": "bun run --filter '*' test",
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:push": "bun run --cwd backend db:push",
		"db:generate": "bun run --cwd backend db:generate",
		"db:migrate": "bun run --cwd backend db:migrate",
		"db:studio": "bun run --cwd backend db:studio",
		"db:seed": "bun run --cwd backend db:seed",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"lefthook": "^2.1.10",
		"typescript": "^5.9.3"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
