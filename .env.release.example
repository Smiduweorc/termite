# Configuration for docker-compose.release.yml:
#
#   cp .env.release.example .env
#
# This is a *deployment* file. backend/.env.example is the separate one for running from
# source in development.

# --- Images -------------------------------------------------------------------------
# Pin this. `latest` is convenient until an upgrade lands while you were not looking.
TERMITE_VERSION=latest
IMAGE_NAMESPACE=smiduweorc

# --- The two addresses everything else hangs off --------------------------------------
# Both are resolved by the browser, so neither can be a compose service name like
# "backend". These are what you or your reverse proxy publish.
#
# They must be the same site: Termite's cookies are SameSite=Lax with no "none" option,
# so board.example.com + api.example.com works, and board.example.com + api.other.net
# silently loses the login. Everything but http://localhost must be https, because every
# cookie the app sets is Secure.
#
# If the two are on different hostnames, set COOKIE_DOMAIN below as well. Same site is
# what gets the cookies sent; it is not enough to let the page read the one it has to.
PUBLIC_APP_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:3000

# --- Database -------------------------------------------------------------------------
POSTGRES_USER=termite
POSTGRES_DB=termite
# Required. This is not exposed outside the compose network, but it is still the only
# thing between a compromised container and the data.
POSTGRES_PASSWORD=

# --- Auth -------------------------------------------------------------------------
# Required, and it must be random:
#   openssl rand -base64 48
# lacewing entropy-checks it at boot. A human-chosen passphrase, however long, throws and
# the backend will not start.
JWT_SECRET=

# Access tokens cannot be revoked before they expire, so keep this short. Capped at 1h.
JWT_ACCESS_EXPIRY=15m
# Refresh tokens are opaque, stored hashed and revocable, so this can be generous.
REFRESH_TOKEN_TTL_DAYS=7
# lax | strict. strict is safer and logs people out when they arrive from an external
# link, which for a feedback board people reach from elsewhere is usually the wrong trade.
COOKIE_SAME_SITE=lax

# The parent domain shared by PUBLIC_APP_URL and PUBLIC_API_URL. Leave it empty if the
# two are on the same host (including the localhost defaults above) - it is only needed
# when they differ, and it is required then.
#
# Termite's CSRF defence is double-submit: the page reads a token from a cookie and
# echoes it in a header, which a cross-site page cannot do because it cannot read the
# cookie. But a cookie set by api.example.com is invisible to script on
# board.example.com, so on a split deployment the page finds nothing to echo and the
# server refuses every write - filing feedback, voting, ticking a task off, even signing
# out - while reads carry on working. Setting this to example.com scopes that one cookie
# to the parent and both hosts can see it.
#
# Only the CSRF token widens; the session cookies stay pinned to the API host. Set it no
# broader than you must, and only across subdomains you control: anything running on a
# subdomain of this value can read and write the token, which is most of what the check
# is defending. A public-subdomain host (github.io, pages.dev, herokuapp.com) is not a
# domain to set this to.
#
# COOKIE_DOMAIN=example.com
COOKIE_DOMAIN=

# --- Ports on the host ------------------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=3000
GRPC_PORT=50051

# --- Logging ------------------------------------------------------------------------
# debug | info | warn | error | silent. NDJSON, since NODE_ENV is production here.
LOG_LEVEL=info

# --- Mail (optional) ------------------------------------------------------------------
# Leave SMTP_HOST empty and invite/reset links go to `docker compose logs backend`
# instead of being emailed. Fine for a private board, not for anything wider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Termite <termite@localhost>
